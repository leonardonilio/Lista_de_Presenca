<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AdminEvento.GerarQrCode">

    <!-- Título -->

    <TextView
        android:id="@+id/edtTextoID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="QR Code do Evento"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:textColor="@android:color/black" />

    <!-- Imagem do QR Code -->
    <ImageView
        android:id="@+id/qrImage"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/edtTextoID"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="QR Code gerado"
        android:background="@android:color/white"
        android:padding="8dp" />

    <!-- Botão de imprimir via Bluetooth -->

    <!-- Botão de imprimir via USB -->

</androidx.constraintlayout.widget.ConstraintLayout>
