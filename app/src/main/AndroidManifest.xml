<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.usb.host" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QRCode">
        <activity
            android:name=".EventosFechados"
            android:exported="false" />
        <activity
            android:name=".ListaDePresenca"
            android:exported="false" />
        <activity
            android:name=".DetalhesDoEvento"
            android:exported="false" />
        <activity
            android:name=".PresencaDoEvento"
            android:exported="false" />
        <activity
            android:name=".CadastrarUsuario"
            android:exported="false" />
        <activity
            android:name=".GerarQrCode"
            android:exported="false" />
        <activity
            android:name=".ManutencaoEvento"
            android:exported="false" />
        <activity
            android:name=".CadastrarEvento"
            android:exported="false" />
        <activity
            android:name=".EventoMain"
            android:exported="false" />
        <activity
            android:name=".AdminEventoMain"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
    </application>

</manifest>